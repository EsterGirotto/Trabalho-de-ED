CREATE DATABASE IF NOT EXISTS estruturas_dados
  CHARACTER SET utf8mb4
  COLLATE utf8mb4_unicode_ci;

USE estruturas_dados;

CREATE TABLE IF NOT EXISTS usuarios (
  id            INT UNSIGNED     NOT NULL AUTO_INCREMENT,
  nome          VARCHAR(150)     NOT NULL,
  ra            VARCHAR(30)      NOT NULL UNIQUE,
  email         VARCHAR(150)     NOT NULL UNIQUE,
  senha_hash    VARCHAR(255)     NOT NULL,
  termo         TINYINT UNSIGNED NOT NULL,
  foto_perfil   VARCHAR(255)     NULL DEFAULT NULL,
  ativo         TINYINT(1)       NOT NULL DEFAULT 1,
  criado_em     DATETIME         NOT NULL DEFAULT CURRENT_TIMESTAMP,
  atualizado_em DATETIME         NULL DEFAULT NULL ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  INDEX idx_email (email),
  INDEX idx_ra    (ra)
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS sessoes (
  id          INT UNSIGNED NOT NULL AUTO_INCREMENT,
  usuario_id  INT UNSIGNED NOT NULL,
  token       VARCHAR(128) NOT NULL UNIQUE,
  ip          VARCHAR(45)  NULL,
  lembrar     TINYINT(1)   NOT NULL DEFAULT 0,
  criado_em   DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP,
  expira_em   DATETIME     NOT NULL,
  PRIMARY KEY (id),
  INDEX idx_token      (token),
  INDEX idx_usuario_id (usuario_id),
  CONSTRAINT fk_sessao_usuario
    FOREIGN KEY (usuario_id) REFERENCES usuarios(id)
    ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS topicos (
  id        TINYINT UNSIGNED NOT NULL AUTO_INCREMENT,
  slug      VARCHAR(50)      NOT NULL UNIQUE,
  titulo    VARCHAR(100)     NOT NULL,
  descricao TEXT             NULL,
  ordem     TINYINT UNSIGNED NOT NULL DEFAULT 0,
  PRIMARY KEY (id)
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS progresso (
  id             INT UNSIGNED     NOT NULL AUTO_INCREMENT,
  usuario_id     INT UNSIGNED     NOT NULL,
  topico_id      TINYINT UNSIGNED NOT NULL,
  visualizado    TINYINT(1)       NOT NULL DEFAULT 0,
  visualizado_em DATETIME         NULL,
  PRIMARY KEY (id),
  UNIQUE KEY uq_usuario_topico (usuario_id, topico_id),
  CONSTRAINT fk_prog_usuario
    FOREIGN KEY (usuario_id) REFERENCES usuarios(id)
    ON DELETE CASCADE,
  CONSTRAINT fk_prog_topico
    FOREIGN KEY (topico_id) REFERENCES topicos(id)
    ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS log_acessos (
  id          BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  usuario_id  INT UNSIGNED    NULL,
  pagina      VARCHAR(100)    NOT NULL,
  ip          VARCHAR(45)     NULL,
  acessado_em DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  INDEX idx_usuario_id (usuario_id),
  INDEX idx_pagina     (pagina),
  CONSTRAINT fk_log_usuario
    FOREIGN KEY (usuario_id) REFERENCES usuarios(id)
    ON DELETE SET NULL
) ENGINE=InnoDB;

